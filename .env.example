# Local Plane MCP configuration. Copy to .env and keep it untracked.
PLANE_API_URL=https://plane.example.com
PLANE_API_TOKEN=replace-with-local-token
PLANE_WORKSPACE_SLUG=workspace-slug
PLANE_INSTANCE_ID=stable-plane-instance-id

# Optional runtime state/configuration:
# PLANE_TIMEOUT=20
# PLANE_MUTATION_LEDGER=/absolute/path/to/existing/mutations.json
